# Copy to server/.env and fill in values. Never commit .env.
PLANTNET_API_KEY=
MONGODB_URI=
PORT=4000
MAX_IMAGE_MB=5
# Set to "true" to disable identification for everyone (shared quota protection)
IDENTIFY_KILL_SWITCH=false
CLIENT_ORIGIN=http://localhost:5173
# Auth: generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= ''
JWT_EXPIRES_DAYS=7
# true in production (HTTPS only)
COOKIE_SECURE=false
# Tests only: MUST be a separate database whose name contains "test"
MONGODB_TEST_URI=
# Identifications per IP per day for visitors without an account
VISITOR_DAILY_LIMIT=3
# Identifications per logged-in user per day (UTC day)
USER_DAILY_IDENTIFY_LIMIT=10
# Phase 3. Keep both keys secret, server only.
# Perenual API key (perenual.com/user/developer), for species care data
PERENUAL_API_KEY=
# How many days a cached species answer (found, not found, restricted) is trusted
CARE_CACHE_DAYS=30
# Anthropic API key (Claude Console > Settings > API keys), for the care plan. Needs prepaid credit.
ANTHROPIC_API_KEY=
# Set to "true" to stop every LLM call for everyone (shared budget protection)
LLM_KILL_SWITCH=false
# Care plans (LLM calls) per user per day (UTC day)
USER_DAILY_LLM_LIMIT=20
# Model for the care plan
CARE_PLAN_MODEL=claude-haiku-5-5
# Set to "false" to stop the in-process reminder scheduler (it is always off in tests)
SCHEDULER_ENABLED=true
